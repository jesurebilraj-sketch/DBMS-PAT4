{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?action=$1" },
    { "source": "/css/(.*)", "destination": "/web/css/$1" },
    { "source": "/js/(.*)", "destination": "/web/js/$1" },
    { "source": "/database/(.*)", "destination": "/database/$1" },
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/(.*)", "destination": "/web/$1" }
  ]
}
